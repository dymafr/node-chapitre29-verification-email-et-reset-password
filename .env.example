# Copiez ce fichier en .env et remplacez les valeurs.
# Le fichier .env est ignoré par Git : il ne doit jamais être publié.

# mot de passe de la boîte de test
MAILTRAP_PASS=
# identifiant de la boîte de test
MAILTRAP_USER=
# URL de connexion à votre base MongoDB, avec identifiant et mot de passe
MONGO_URL=
# development ou production
NODE_ENV=
# clé d'API du service d'envoi d'emails
RESEND_API_KEY=
# chaîne longue et tirée au hasard, qui signe les cookies de session
SESSION_SECRET=
