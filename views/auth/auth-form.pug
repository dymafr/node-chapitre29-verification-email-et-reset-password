extends ../layout

block content
  script(src="/javascripts/auth/auth-form.js")
  div(class="d-flex flex-row content justify-content-center mx-auto")
    form(class="card w-50 mt-5" method="post" action="/auth/signin")
      div(class="card-header") Connexion
      div(class="card-body")
        div(class="mb-3")
          label(for="email") Email
          input(id="email" class="form-control" type="email" name="email" autocomplete="email" required)
        div(class="mb-3")
          label(for="password") Password
          input(id="password" class="form-control" type="password" name="password" autocomplete="current-password" required)
        if errors
          ul(class="my-2")
            each error in errors
              li(class="text-danger")= error
        div(class="w-100 d-flex flex-row justify-content-between align-items-center")
          div(id="forgot" class="text-hint") forgot password ?
          input(type="submit" value="connexion" class="btn btn-primary ms-auto d-block")
